{
    // One Rust binary crate. CI runs `cargo fmt --check`, so rustfmt is the
    // authority on layout and formatting the whole file on save is safe.
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,

    // Two rulers because two limits are real: 100 is rustfmt's max_width, which
    // is what actually gets enforced, and 80 is what src/ is written to (95% of
    // lines fit).
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.rulers": [80, 100]
    },
    "[markdown]": {
        "editor.tabSize": 2,
        "editor.rulers": [80]
    },

    "rust-analyzer.files.excludeDirs": [
        "target"
    ],

    "files.exclude": {
        "target": true
    },
    // vendor/frida is a patched path dependency, not a build artifact: it must
    // stay visible and rust-analyzer must index it. It just has no business
    // showing up in a search for something in src/.
    "search.exclude": {
        "vendor": true
    },
    "files.watcherExclude": {
        "**/target/**": true
    }
}
